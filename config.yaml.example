# Exemple de configuration — copier en config.yaml (NON versionné).
# Toutes les valeurs sensibles (SMTP, clés) sont fournies via variables d'environnement
# ou ce fichier local. Ne commitez jamais config.yaml réel.

admin_recovery_code: CHANGE-ME-RECOVERY
secret_key: CHANGE-ME-SECRET-KEY

custom_config: --oem 3 --psm 7 -c tessedit_char_whitelist=ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789
database_url: sqlite:///parking.db
tesseract_cmd: C:\Program Files\Tesseract-OCR\tesseract.exe

# Les identifiants SMTP peuvent aussi être fournis par les variables d'environnement :
#   UCB_SMTP_HOST, UCB_SMTP_PORT, UCB_SMTP_USER, UCB_SMTP_PASSWORD, UCB_SMTP_FROM
smtp:
  host: smtp.gmail.com
  port: 587
  user: ""
  password: ""
  from_address: ""

forbidden_yolo_classes:
  - truck
  - bus
forbidden_vehicle_types:
  - camping_car
  - poids_lourd
  - bus
