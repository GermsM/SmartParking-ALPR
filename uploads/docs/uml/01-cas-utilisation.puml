@startuml
left to right direction
skinparam packageStyle rectangle

actor Administrateur as Admin
actor Gardien
actor "Caméra d'entrée/sortie" as Camera
actor "Propriétaire du véhicule" as Owner

rectangle "SmartParking UCB" {
  usecase "Se connecter" as UCLogin
  usecase "Consulter tableau de bord" as UCDashboard
  usecase "Gérer les véhicules" as UCVehicles
  usecase "Ajouter / modifier un véhicule" as UCManageVehicle
  usecase "Valider, bannir ou réactiver" as UCValidate
  usecase "Configurer sites, caméras\net barrières" as UCConfig
  usecase "Suivre la détection live" as UCLive
  usecase "Détecter véhicule et plaque" as UCDetect
  usecase "Vérifier autorisation" as UCAuthorize
  usecase "Ouvrir / fermer la barrière" as UCGate
  usecase "Consulter notifications" as UCNotifications
  usecase "Contacter le propriétaire" as UCContact
  usecase "Exporter / consulter les journaux" as UCLogs
  usecase "Demander l'enregistrement\nd'un véhicule" as UCRequest
}

Admin --> UCLogin
Admin --> UCDashboard
Admin --> UCVehicles
Admin --> UCManageVehicle
Admin --> UCValidate
Admin --> UCConfig
Admin --> UCLive
Admin --> UCNotifications
Admin --> UCLogs

Gardien --> UCLogin
Gardien --> UCLive
Gardien --> UCVehicles
Gardien --> UCRequest
Gardien --> UCNotifications
Gardien --> UCContact
Gardien --> UCGate

Camera --> UCDetect
UCDetect --> UCAuthorize : <<include>>
UCAuthorize --> UCGate : <<extend>>
UCAuthorize --> UCNotifications : <<extend>>
UCContact --> Owner
@enduml
