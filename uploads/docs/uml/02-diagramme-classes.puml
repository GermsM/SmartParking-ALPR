@startuml
hide methods
skinparam classAttributeIconSize 0

class Site {
  +id: Integer
  +name: String
  +code: String
  +capacity: Integer
  +camera_url_entry: String
  +camera_url_exit: String
  +access_start: String
  +access_end: String
  +long_stay_hours: Integer
  +gate_ip: String
}

class User {
  +id: Integer
  +username: String
  +password: String
  +role: String
  +full_name: String
  +site: String
  +is_active: Boolean
  +must_change_password: Boolean
}

class Vehicle {
  +id: Integer
  +plate_number: String
  +owner_name: String
  +owner_phone: String
  +owner_email: String
  +vehicle_model: String
  +vehicle_type: String
  +function: String
  +site_authorized: String
  +status: String
  +created_at: DateTime
}

class AccessLog {
  +id: Integer
  +plate_number: String
  +action: String
  +status: String
  +site: String
  +timestamp: DateTime
  +duration_minutes: Integer
}

class Notification {
  +id: Integer
  +site: String
  +category: String
  +message: String
  +plate_number: String
  +contact_phone: String
  +whatsapp_message: String
  +created_at: DateTime
  +is_read: Boolean
}

class NotificationRead {
  +id: Integer
  +read_at: DateTime
}

Site "1" <-- "0..*" User : site_id
Site "1" <-- "0..*" Vehicle : site_id
Site "1" <-- "0..*" AccessLog : site_id
Site "1" <-- "0..*" Notification : site_id
User "1" <-- "0..*" Vehicle : created_by
User "1" <-- "0..*" AccessLog : guardian_id
User "1" <-- "0..*" Notification : guardian_id
Vehicle "0..1" <-- "0..*" AccessLog : vehicle_id
Notification "1" <-- "0..*" NotificationRead : notification_id
User "1" <-- "0..*" NotificationRead : user_id

note bottom of Vehicle
status : pending, active ou banned
vehicle_type : auto, moto ou sans_plaque
end note
@enduml
