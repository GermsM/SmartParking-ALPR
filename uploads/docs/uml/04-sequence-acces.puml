@startuml
actor Gardien
participant "Caméra" as Camera
participant "Pipeline ALPR" as ALPR
participant "Base véhicules" as DB
participant "Barrière" as Gate
participant "Notifications" as Notif

Camera -> ALPR : frame vidéo
ALPR -> ALPR : YOLO véhicule
ALPR -> ALPR : YOLO plaque\nou fallback zone basse
ALPR -> ALPR : prétraitement + OCR
ALPR -> DB : rechercher(plate)
DB --> ALPR : véhicule / statut

alt Plaque active et autorisée
  ALPR -> Gate : ouvrir entrée ou sortie
  ALPR -> DB : créer AccessLog
  Gate --> Gardien : accès affiché
else Plaque inconnue ou non lue
  ALPR -> Notif : créer alerte
  Notif --> Gardien : notification
else Plaque bannie
  ALPR -> Notif : alerte véhicule interdit
  Notif --> Gardien : notification critique
end
@enduml
