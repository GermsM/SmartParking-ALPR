@startuml
skinparam state {
  BackgroundColor #FEFECE
  BorderColor #A80036
  FontSize 12
}

title Diagramme d'états — Statut du véhicule

[*] --> pending : enregistrement (gardien)

pending --> active : admin approuve
pending --> banned : admin refuse / bannit

active --> banned : admin bannit
banned --> active : admin réactive

active --> active : mise à jour profil
banned --> banned : mise à jour profil
active --> [*] : suppression du registre
banned --> [*] : suppression du registre
pending --> [*] : suppression du registre

note right of active
  Le véhicule est autorisé
  à l'accès au parking.
end note

note right of banned
  Accès suspendu :
  détection -> alerte
  rouge + e-mail propriétaire.
end note
@enduml
