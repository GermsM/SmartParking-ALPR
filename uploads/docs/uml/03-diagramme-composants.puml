@startuml
skinparam componentStyle rectangle

actor Administrateur
actor Gardien
component "Interface Web Flask\n(templates Bootstrap)" as UI
component "Routes Flask\napp.py + blueprints" as Routes
component "Gestion véhicules\nvehicles.py" as Vehicles
component "Authentification\nauth.py" as Auth
component "Notifications\nnotifications.py" as Notifications
component "ALPR\nYOLO + OpenCV + Tesseract" as ALPR
component "Contrôle barrière\ntrigger_gate" as Gate
database "SQLite / PostgreSQL\nSQLAlchemy" as DB
component "Caméra IP / fichier vidéo" as Camera
component "WhatsApp / application d'appel" as Contact

Administrateur --> UI
Gardien --> UI
UI --> Routes
Routes --> Auth
Routes --> Vehicles
Routes --> Notifications
Routes --> ALPR
Routes --> Gate
Vehicles --> DB
Auth --> DB
Notifications --> DB
ALPR --> DB : vérification plaque
Camera --> ALPR : flux vidéo
Routes --> Contact : liens tel: / wa.me
Gate --> Camera : statut de passage
@enduml
